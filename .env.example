# ============================================================
# Supriya & Dr. Ranjan Wedding Invitation — Environment Config
# ============================================================
# All variables are OPTIONAL. Without Supabase credentials,
# RSVP & Blessings automatically run in transparent Demo Mode
# using an in-memory API store + browser localStorage persistence.

# ------------------------------------------------------------
# 1. Supabase Configuration (Recommended for Production)
# ------------------------------------------------------------
# Create a free project at https://supabase.com and run the SQL
# schema documented in README.md.
# Keep SUPABASE_SERVICE_ROLE_KEY strictly server-side (never prefix with NEXT_PUBLIC_).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional public URL/anon key only if you inspect status; server routes use SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------
# 2. Configurable Wedding Placeholders (Update when ready)
# ------------------------------------------------------------
# Bride's residence address for Haldi & Mehndi (23 Nov 2026)
# Leave blank to show the respectful "Address to be shared personally" placeholder.
NEXT_PUBLIC_HALDI_ADDRESS=

# RSVP Contact Phone Number for Mr. Ram Kumar
# Leave blank to display the configurable placeholder notice.
NEXT_PUBLIC_RSVP_PHONE=
